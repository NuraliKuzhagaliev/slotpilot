# Server-only. Never put any of these in NEXT_PUBLIC_ variables.
ASSEMBLYAI_API_KEY=
SUPABASE_URL=
# Prefer the new server secret. Legacy service_role remains supported.
SUPABASE_SECRET_KEY=
# Public key is optional for the bundled demo project; required for other Supabase projects.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
DEMO_NAMESPACE=slotpilot-demo
VOICE_MAX_SESSION_SECONDS=300
VOICE_DAILY_TOKEN_LIMIT=10
